# AgriFusion — Environment Variables Reference
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to git.
#
# All values below are empty placeholders.
# Do not put real secrets in this file.

# Supabase (https://supabase.com)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated

# Roboflow API (https://roboflow.com)
ROBOFLOW_API_KEY=

# Hugging Face Inference API (https://huggingface.co)
HF_TOKEN=

# Admin credentials — set strong values in production
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Service URLs
BACKEND_URL=
FRONTEND_URL=

# External API endpoints (public defaults provided)
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1/forecast
SOILGRIDS_BASE_URL=https://rest.isric.org/soilgrids/v2.0/properties/query

# Supabase Storage bucket name (optional, defaults to crop-images)
SUPABASE_BUCKET=crop-images
