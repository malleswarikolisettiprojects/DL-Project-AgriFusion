          "crop",
          "image"
        ],
        "title": "Body_api_predict_disease_api_v1_predict_disease_post"
      },
      "ClimateRiskRequest": {
        "properties": {
          "state": {
            "type": "string",
            "title": "State",
            "example": "Andhra Pradesh"
          },
          "district": {
            "type": "string",
            "title": "District",
            "example": "Visakhapatnam"
          },
          "crop": {
            "type": "string",
            "title": "Crop",
            "example": "Rice"
          },
          "sowing_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sowing Date",
            "example": "2026-06-15"
          }
        },
        "type": "object",
        "required": [
          "state",
          "district",
          "crop"
        ],
        "title": "ClimateRiskRequest"
      },
      "CropRequest": {
        "properties": {
          "state": {
            "type": "string",
            "title": "State",
            "example": "Andhra Pradesh"
          },
          "district": {
            "type": "string",
            "title": "District",
            "example": "Visakhapatnam"
          },
          "village": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Village",
            "example": "Anakapalle"
          },
          "sowing_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sowing Date",
            "example": "2026-06-15"
          }
        },
        "type": "object",
        "required": [
          "state",
          "district"
        ],
        "title": "CropRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IrrigationRequest": {
        "properties": {
          "state": {
            "type": "string",
            "title": "State",
            "example": "Andhra Pradesh"
          },
          "district": {
            "type": "string",
            "title": "District",
            "example": "Visakhapatnam"
          },
          "crop": {
            "type": "string",
            "title": "Crop",
            "example": "Rice"
          },
          "area_ha": {
            "type": "number",
            "title": "Area Ha",
            "default": 2.0,
            "example": 2.0
          },
          "start_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Date",
            "example": "2026-06-15"
          },
          "pump_hp": {
            "type": "number",
            "title": "Pump Hp",
            "default": 5.0,
            "example": 5.0
          }
        },
        "type": "object",
        "required": [
          "state",
          "district",
          "crop"
        ],
        "title": "IrrigationRequest"
      },
      "MarketRequest": {
        "properties": {
          "state": {
            "type": "string",
            "title": "State",
            "example": "Andhra Pradesh"
          },
          "district": {
            "type": "string",
            "title": "District",
            "example": "Visakhapatnam"
          },
          "commodity": {
            "type": "string",
            "title": "Commodity",
            "example": "Rice"
          },
          "area_ha": {
            "type": "number",
            "title": "Area Ha",
            "default": 2.0,
            "example": 2.0
          },
          "season": {
            "type": "string",
            "title": "Season",
            "default": "Kharif",
            "example": "Kharif"
          },
          "start_date": {
            "type": "string",
            "title": "Start Date",
            "example": "2026-06-15"
          },
          "end_date": {
            "type": "string",
            "title": "End Date",
            "example": "2026-10-15"
          },
          "year": {
            "type": "integer",
            "title": "Year",
            "default": 2026,
            "example": 2026
          },
          "market_date": {
